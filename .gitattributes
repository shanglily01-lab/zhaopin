# 默认按需自动检测
* text=auto

# Shell / 配置类一律 LF，避免 Windows -> Linux 的 CRLF 问题
*.sh         text eol=lf
*.service    text eol=lf
*.conf       text eol=lf
deploy/*     text eol=lf

# Python / HTML / CSS / JS 用 LF
*.py         text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.js         text eol=lf
*.json       text eol=lf
*.md         text eol=lf

# 二进制文件不做转换
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.pdf        binary
